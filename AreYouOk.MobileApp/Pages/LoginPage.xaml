<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AreYouOk.MobileApp.ViewModels"
             x:Class="AreYouOk.MobileApp.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="AreYouOk - Login"
             Shell.NavBarIsVisible="False">

    <!-- Beautiful login page example -->
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
            
            <!-- App Logo/Title -->
            <Label Text="AreYouOk"
                   FontSize="42"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}"
                   Margin="0,40,0,20"/>
            
            <Label Text="Your Personal Safety Companion"
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Gray600}"
                   Margin="0,0,0,40"/>

            <!-- Email Entry -->
            <Frame BorderColor="{StaticResource Gray300}"
                   HasShadow="False"
                   Padding="0"
                   CornerRadius="10">
                <Entry Placeholder="Email"
                       Text="{Binding Email}"
                       Keyboard="Email"
                       FontSize="16"
                       Margin="15,10"/>
            </Frame>

            <!-- Password Entry -->
            <Frame BorderColor="{StaticResource Gray300}"
                   HasShadow="False"
                   Padding="0"
                   CornerRadius="10">
                <Entry Placeholder="Password"
                       Text="{Binding Password}"
                       IsPassword="True"
                       FontSize="16"
                       Margin="15,10"/>
            </Frame>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   FontSize="14"
                   Margin="0,10,0,0"/>

            <!-- Login Button -->
            <Button Text="Login"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="55"
                    Margin="0,20,0,0"/>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             Color="{StaticResource Primary}"
                             HeightRequest="40"/>

            <!-- Register Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,30,0,0">
                <Label Text="Don't have an account?"
                       TextColor="{StaticResource Gray600}"
                       FontSize="14"/>
                <Label Text="Register"
                       TextColor="{StaticResource Primary}"
                       FontAttributes="Bold"
                       FontSize="14">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

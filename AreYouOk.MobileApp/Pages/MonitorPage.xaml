<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AreYouOk.MobileApp.ViewModels"
             x:Class="AreYouOk.MobileApp.Pages.MonitorPage"
             x:DataType="viewmodels:MonitorViewModel"
             Title="Monitor Family">

    <RefreshView IsRefreshing="{Binding IsLoading}"
                 Command="{Binding RefreshCommand}">
        <Grid>
            <!-- Journey List -->
            <CollectionView ItemsSource="{Binding MonitoredJourneys}"
                           IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}"
                           Margin="10">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="15"
                               Padding="20"
                               Margin="10,5"
                               BackgroundColor="{StaticResource Surface}"
                               HasShadow="True"
                               BorderColor="{Binding Status, Converter={StaticResource JourneyStatusToBorderColorConverter}}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MonitorViewModel}}, Path=ViewJourneyDetailsCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            
                            <Grid ColumnDefinitions="70,*" ColumnSpacing="15" RowSpacing="10">
                                <!-- User Avatar -->
                                <Frame Grid.Column="0" Grid.RowSpan="2"
                                       WidthRequest="70"
                                       HeightRequest="70"
                                       CornerRadius="35"
                                       Padding="0"
                                       BackgroundColor="{StaticResource Primary}"
                                       HasShadow="False">
                                    <Label Text="👤"
                                           FontSize="40"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Frame>

                                <!-- User Info -->
                                <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="5">
                                    <Label Text="{Binding User.FirstName, StringFormat='{0}''s Journey'}"
                                           FontSize="18"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding User.PhoneNumber}"
                                           FontSize="14"
                                           TextColor="{StaticResource Gray600}" />
                                </VerticalStackLayout>

                                <!-- Journey Status -->
                                <VerticalStackLayout Grid.Column="1" Grid.Row="1" Spacing="5">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="Status:"
                                               FontSize="13"
                                               TextColor="{StaticResource Gray600}" />
                                        <Label Text="{Binding Status}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{Binding Status, Converter={StaticResource JourneyStatusToColorConverter}}" />
                                    </HorizontalStackLayout>
                                    
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="⏰"
                                               FontSize="12" />
                                        <Label Text="{Binding TimeUntilNextCheckIn, Converter={StaticResource TimeSpanToStringConverter}}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray600}" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="🕒"
                                               FontSize="12" />
                                        <Label Text="{Binding StartTime, StringFormat='Started {0:hh:mm tt}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray600}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Alert Indicator -->
                                <Frame Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                       IsVisible="{Binding Status, Converter={StaticResource JourneyStatusIsAlertConverter}}"
                                       WidthRequest="50"
                                       HeightRequest="50"
                                       CornerRadius="25"
                                       Padding="0"
                                       BackgroundColor="{StaticResource Error}"
                                       HasShadow="True"
                                       HorizontalOptions="End"
                                       VerticalOptions="Start"
                                       Margin="0,-10,-10,0">
                                    <Label Text="⚠"
                                           FontSize="30"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Frame>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Empty State -->
            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Spacing="20"
                                Padding="40">
                <Label Text="👨‍👩‍👧‍👦"
                       FontSize="80"
                       HorizontalOptions="Center" />
                <Label Text="{Binding EmptyMessage}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray600}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <Label Text="When family members add you to their journeys, you'll see them here"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </RefreshView>

</ContentPage>

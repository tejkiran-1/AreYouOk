<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AreYouOk.MobileApp.ViewModels"
             x:Class="AreYouOk.MobileApp.Pages.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Title="AreYouOk">

    <RefreshView IsRefreshing="{Binding IsLoading}"
                 Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Welcome Header -->
                <Frame CornerRadius="15"
                       Padding="20"
                       BackgroundColor="{StaticResource Primary}"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding UserName, StringFormat='Welcome, {0}!'}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="{Binding StatusMessage}"
                               FontSize="14"
                               TextColor="White"
                               Opacity="0.9" />
                    </VerticalStackLayout>
                </Frame>

                <!-- No Active Journey -->
                <Frame CornerRadius="15"
                       Padding="30"
                       BackgroundColor="{StaticResource Surface}"
                       HasShadow="True"
                       IsVisible="{Binding HasActiveJourney, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="20">
                        <Label Text="🛡️"
                               FontSize="60"
                               HorizontalOptions="Center" />
                        <Label Text="Start Your Journey"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="Going out? Add your family members and start a journey to keep them informed about your safety."
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,10" />
                        <Button Text="Start New Journey"
                                Command="{Binding StartJourneyCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold"
                                HeightRequest="55"
                                CornerRadius="27"
                                HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Active Journey -->
                <Frame CornerRadius="15"
                       Padding="20"
                       BackgroundColor="{StaticResource Surface}"
                       HasShadow="True"
                       IsVisible="{Binding HasActiveJourney}">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="🚀 Journey in Progress"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Success}"
                               HorizontalOptions="Center" />
                        
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{StaticResource Gray200}"
                                 Margin="0,5,0,5" />

                        <Grid ColumnDefinitions="Auto,*" 
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="10" 
                              RowSpacing="10">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Started:"
                                   FontSize="14"
                                   TextColor="{StaticResource Gray600}" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding ActiveJourney.StartTime, StringFormat='{0:hh:mm tt}'}"
                                   FontSize="14"
                                   FontAttributes="Bold" />

                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="Family:"
                                   FontSize="14"
                                   TextColor="{StaticResource Gray600}" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding ActiveJourney.FamilyMembers.Count, StringFormat='{0} members'}"
                                   FontSize="14"
                                   FontAttributes="Bold" />

                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="Check-in:"
                                   FontSize="14"
                                   TextColor="{StaticResource Gray600}" />
                            <Label Grid.Row="2" Grid.Column="1"
                                   Text="{Binding ActiveJourney.CheckInIntervalHours, StringFormat='Every {0:F2} hours'}"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                        </Grid>

                        <Button Text="Go to Journey"
                                Command="{Binding ViewActiveJourneyCommand}"
                                BackgroundColor="{StaticResource Success}"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold"
                                HeightRequest="50"
                                CornerRadius="25"
                                Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Quick Info Cards -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Frame Grid.Column="0"
                           CornerRadius="15"
                           Padding="15"
                           BackgroundColor="{StaticResource Surface}"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="📜"
                                   FontSize="30"
                                   HorizontalOptions="Center" />
                            <Label Text="History"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="View past journeys"
                                   FontSize="11"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource Gray600}" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1"
                           CornerRadius="15"
                           Padding="15"
                           BackgroundColor="{StaticResource Surface}"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="👨‍👩‍👧‍👦"
                                   FontSize="30"
                                   HorizontalOptions="Center" />
                            <Label Text="Monitor"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="Track family"
                                   FontSize="11"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource Gray600}" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Safety Tips -->
                <Frame CornerRadius="15"
                       Padding="15"
                       BackgroundColor="#FFF8E1"
                       HasShadow="False">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="💡 Safety Tip"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#F57C00" />
                        <Label Text="Always inform your family before starting a journey. Set realistic check-in intervals."
                               FontSize="12"
                               TextColor="#E65100" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>

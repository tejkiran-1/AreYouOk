<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AreYouOk.MobileApp.ViewModels"
             x:Class="AreYouOk.MobileApp.Pages.ProfilePage"
             x:DataType="viewmodels:ProfileViewModel"
             Title="Profile">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!-- Profile Header -->
            <Frame CornerRadius="20"
                   Padding="30"
                   BackgroundColor="{StaticResource Primary}"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <!-- Avatar -->
                    <Frame WidthRequest="100"
                           HeightRequest="100"
                           CornerRadius="50"
                           Padding="0"
                           BackgroundColor="White"
                           HasShadow="False"
                           HorizontalOptions="Center">
                        <Label Text="👤"
                               FontSize="60"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Frame>

                    <Label Text="{Binding FirstName, StringFormat='{0}'}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    
                    <Label Text="{Binding Email}"
                           FontSize="14"
                           TextColor="White"
                           Opacity="0.9"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Profile Information -->
            <Frame CornerRadius="15"
                   Padding="20"
                   BackgroundColor="{StaticResource Surface}"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="📋 Profile Information"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15" RowSpacing="15">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Name:"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding FirstName, StringFormat='{0} '}"
                               FontSize="14"
                               FontAttributes="Bold" />

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Last Name:"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding LastName}"
                               FontSize="14"
                               FontAttributes="Bold" />

                        <Label Grid.Row="2" Grid.Column="0"
                               Text="Email:"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}" />
                        <Label Grid.Row="2" Grid.Column="1"
                               Text="{Binding Email}"
                               FontSize="14"
                               FontAttributes="Bold" />

                        <Label Grid.Row="3" Grid.Column="0"
                               Text="Phone:"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}" />
                        <Label Grid.Row="3" Grid.Column="1"
                               Text="{Binding PhoneNumber}"
                               FontSize="14"
                               FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- App Information -->
            <Frame CornerRadius="15"
                   Padding="20"
                   BackgroundColor="{StaticResource Surface}"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="ℹ️ App Information"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15" RowSpacing="15">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Version:"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="1.0.0"
                               FontSize="14"
                               FontAttributes="Bold" />

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Platform:"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text=".NET MAUI"
                               FontSize="14"
                               FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Settings & Actions -->
            <Frame CornerRadius="15"
                   Padding="20"
                   BackgroundColor="{StaticResource Surface}"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="⚙️ Settings"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           Margin="0,0,0,10" />

                    <Button Text="Change API URL"
                            Command="{Binding ChangeApiUrlCommand}"
                            BackgroundColor="{StaticResource Gray300}"
                            TextColor="{StaticResource Gray900}"
                            FontSize="14"
                            HeightRequest="45"
                            CornerRadius="10" />
                </VerticalStackLayout>
            </Frame>

            <!-- About Section -->
            <Frame CornerRadius="15"
                   Padding="20"
                   BackgroundColor="#E3F2FD"
                   HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="💙 About AreYouOk"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="Stay connected with your family and loved ones. Let them know you're safe during your journeys."
                           FontSize="13"
                           TextColor="{StaticResource Gray700}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Logout Button -->
            <Button Text="Logout"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="{StaticResource Error}"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="25"
                    Margin="0,10,0,30" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

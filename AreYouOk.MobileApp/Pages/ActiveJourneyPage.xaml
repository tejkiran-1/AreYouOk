<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AreYouOk.MobileApp.ViewModels"
             x:Class="AreYouOk.MobileApp.Pages.ActiveJourneyPage"
             x:DataType="viewmodels:ActiveJourneyViewModel"
             Title="Active Journey">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!-- Journey Status Card -->
            <Frame CornerRadius="20"
                   Padding="25"
                   BackgroundColor="{StaticResource Success}"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🚀 Journey in Progress"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    
                    <Label Text="{Binding TimeUntilNextCheckIn}"
                           FontSize="16"
                           TextColor="White"
                           HorizontalOptions="Center"
                           Opacity="0.9" />

                    <VerticalStackLayout Spacing="5" Margin="0,10,0,0">
                        <ProgressBar Progress="{Binding ProgressValue}"
                                     ProgressColor="White"
                                     BackgroundColor="#FFFFFF40"
                                     HeightRequest="8" />
                        <Label Text="{Binding ProgressValue, StringFormat='Progress: {0:P0}'}"
                               FontSize="12"
                               TextColor="White"
                               HorizontalOptions="Center"
                               Opacity="0.8" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Safety Status Buttons -->
            <Frame CornerRadius="20"
                   Padding="25"
                   BackgroundColor="{StaticResource Surface}"
                   HasShadow="True">
                <VerticalStackLayout Spacing="20">
                    <Label Text="❓ Are You Safe?"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center" />

                    <Label Text="Tap a button to update your family"
                           FontSize="14"
                           TextColor="{StaticResource Gray600}"
                           HorizontalOptions="Center" />

                    <!-- Safe Button -->
                    <Button Text="✓ YES, I'M SAFE"
                            Command="{Binding UpdateSafetyStatusCommand}"
                            CommandParameter="{x:Boolean True}"
                            BackgroundColor="{StaticResource Success}"
                            TextColor="White"
                            FontSize="20"
                            FontAttributes="Bold"
                            HeightRequest="80"
                            CornerRadius="15"
                            Shadow="{Shadow Brush={StaticResource Success}, Offset='0,4', Radius='8', Opacity='0.3'}" />

                    <!-- Not Safe Button -->
                    <Button Text="⚠ NO, I NEED HELP"
                            Command="{Binding UpdateSafetyStatusCommand}"
                            CommandParameter="{x:Boolean False}"
                            BackgroundColor="{StaticResource Error}"
                            TextColor="White"
                            FontSize="20"
                            FontAttributes="Bold"
                            HeightRequest="80"
                            CornerRadius="15"
                            Shadow="{Shadow Brush={StaticResource Error}, Offset='0,4', Radius='8', Opacity='0.3'}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Journey Details -->
            <Frame CornerRadius="15"
                   Padding="20"
                   BackgroundColor="{StaticResource Surface}"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="📋 Journey Details"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Grid ColumnDefinitions="Auto,*" 
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="10" 
                          RowSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Started:"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding Journey.StartTime, StringFormat='{0:g}'}"
                               FontSize="14"
                               FontAttributes="Bold" />

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Check-in:"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding Journey.CheckInIntervalHours, StringFormat='Every {0:F1} hours'}"
                               FontSize="14"
                               FontAttributes="Bold" />

                        <Label Grid.Row="2" Grid.Column="0"
                               Text="Last Update:"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}" />
                        <Label Grid.Row="2" Grid.Column="1"
                               Text="{Binding Journey.LastCheckInTime, StringFormat='{0:t}'}"
                               FontSize="14"
                               FontAttributes="Bold" />

                        <Label Grid.Row="3" Grid.Column="0"
                               Text="Status:"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}" />
                        <Label Grid.Row="3" Grid.Column="1"
                               Text="{Binding Journey.Status}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Success}" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Family Members -->
            <Frame CornerRadius="15"
                   Padding="20"
                   BackgroundColor="{StaticResource Surface}"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="👨‍👩‍👧‍👦 Family Members Being Notified"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <CollectionView ItemsSource="{Binding FamilyMembers}"
                                    HeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame CornerRadius="10"
                                       Padding="15"
                                       Margin="0,5"
                                       BackgroundColor="{StaticResource Background}"
                                       HasShadow="False">
                                    <Grid ColumnDefinitions="40,*">
                                        <Label Grid.Column="0"
                                               Text="👤"
                                               FontSize="24"
                                               VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                                            <Label Text="{Binding DisplayName}"
                                                   FontSize="16"
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding PhoneNumber}"
                                                   FontSize="14"
                                                   TextColor="{StaticResource Gray600}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}"
                   FontSize="14"
                   TextColor="{StaticResource Primary}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- End Journey Button -->
            <Button Text="End Journey"
                    Command="{Binding EndJourneyCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{StaticResource Gray400}"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="25"
                    Margin="0,10,0,20" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                              IsVisible="{Binding IsLoading}"
                              Color="{StaticResource Primary}"
                              HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

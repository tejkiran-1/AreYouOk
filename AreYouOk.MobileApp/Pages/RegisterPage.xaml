<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AreYouOk.MobileApp.ViewModels"
             x:Class="AreYouOk.MobileApp.Pages.RegisterPage"
             x:DataType="viewmodels:RegisterViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Logo/Header Section -->
            <VerticalStackLayout Spacing="10" Margin="0,40,0,30">
                <Label Text="AreYouOk"
                       FontSize="36"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}" />
                <Label Text="Create your account"
                       FontSize="18"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Gray600}" />
            </VerticalStackLayout>

            <!-- Registration Form -->
            <Frame CornerRadius="15"
                   Padding="20"
                   BackgroundColor="{StaticResource Surface}"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">

                    <!-- First Name -->
                    <Label Text="First Name"
                           FontSize="14"
                           TextColor="{StaticResource Gray600}" />
                    <Entry Text="{Binding FirstName}"
                           Placeholder="Enter your first name"
                           FontSize="16"
                           ReturnType="Next" />

                    <!-- Last Name -->
                    <Label Text="Last Name"
                           FontSize="14"
                           TextColor="{StaticResource Gray600}" />
                    <Entry Text="{Binding LastName}"
                           Placeholder="Enter your last name"
                           FontSize="16"
                           ReturnType="Next" />

                    <!-- Email -->
                    <Label Text="Email"
                           FontSize="14"
                           TextColor="{StaticResource Gray600}" />
                    <Entry Text="{Binding Email}"
                           Placeholder="your.email@example.com"
                           Keyboard="Email"
                           FontSize="16"
                           ReturnType="Next" />

                    <!-- Phone Number -->
                    <Label Text="Phone Number"
                           FontSize="14"
                           TextColor="{StaticResource Gray600}" />
                    <Entry Text="{Binding PhoneNumber}"
                           Placeholder="+1 (555) 123-4567"
                           Keyboard="Telephone"
                           FontSize="16"
                           ReturnType="Next" />

                    <!-- Password -->
                    <Label Text="Password"
                           FontSize="14"
                           TextColor="{StaticResource Gray600}" />
                    <Entry Text="{Binding Password}"
                           Placeholder="At least 6 characters"
                           IsPassword="True"
                           FontSize="16"
                           ReturnType="Next" />

                    <!-- Confirm Password -->
                    <Label Text="Confirm Password"
                           FontSize="14"
                           TextColor="{StaticResource Gray600}" />
                    <Entry Text="{Binding ConfirmPassword}"
                           Placeholder="Re-enter your password"
                           IsPassword="True"
                           FontSize="16"
                           ReturnType="Done" />

                    <!-- Error Message -->
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Error}"
                           FontSize="14"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0" />

                    <!-- Register Button -->
                    <Button Text="Create Account"
                            Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            CornerRadius="25"
                            Margin="0,20,0,0" />

                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                      IsVisible="{Binding IsLoading}"
                                      Color="{StaticResource Primary}"
                                      HorizontalOptions="Center"
                                      Margin="0,10,0,0" />

                </VerticalStackLayout>
            </Frame>

            <!-- Login Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,20,0,0">
                <Label Text="Already have an account?"
                       FontSize="14"
                       TextColor="{StaticResource Gray600}"
                       VerticalOptions="Center" />
                <Label Text="Login"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
